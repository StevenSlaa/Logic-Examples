{
  "schema": "pulsar.logic.library/v1",
  "catalog": {
    "id": "logic-examples",
    "name": "Logic Lab Examples",
    "version": "1.0.0"
  },
  "repository": "https://github.com/StevenSlaa/Logic-Examples",
  "groups": [
    {
      "name": "Basics",
      "description": "Four short circuits, in order. Start here if you have never met a logic gate."
    },
    {
      "name": "Arithmetic",
      "description": "Adding numbers with gates, one binary column at a time."
    },
    {
      "name": "Choosing and routing",
      "description": "Circuits that pick one signal out of several, or point at one output."
    },
    {
      "name": "Memory and time",
      "description": "Circuits that remember, and circuits that move on with a clock."
    },
    {
      "name": "Projects",
      "description": "Bigger circuits that combine everything before them. Each is a small machine: take it one part at a time."
    }
  ],
